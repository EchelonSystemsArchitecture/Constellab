{
  "description": "Each case is a config payload that must be rejected, with the field paths that must appear in the diagnostics.",
  "cases": [
    { "name": "not an object", "config": [1, 2, 3], "expect_paths": ["$"] },
    { "name": "missing required fields", "config": { "schema_version": "1.0.0" }, "expect_paths": ["$.scenario_id", "$.seed", "$.epoch_utc", "$.satellites"] },
    { "name": "unknown operational field", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [], "telemetry_rate_hz": 10 }, "expect_paths": ["$.telemetry_rate_hz"] },
    { "name": "incompatible major version", "config": { "schema_version": "2.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.schema_version"] },
    { "name": "newer minor version", "config": { "schema_version": "1.9.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.schema_version"] },
    { "name": "malformed version string", "config": { "schema_version": "v1", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.schema_version"] },
    { "name": "timestamp without UTC suffix (unit/convention error)", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12 00:00:00", "satellites": [] }, "expect_paths": ["$.epoch_utc"] },
    { "name": "seed not an integer", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1.5, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.seed"] },
    { "name": "seed is a boolean", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": true, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.seed"] },
    { "name": "invalid entity id", "config": { "schema_version": "1.0.0", "scenario_id": "Bad Id!", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.scenario_id"] },
    { "name": "orbit below Earth radius (unit error: metres given as km)", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [ { "id": "a", "orbit": { "semi_major_axis_km": 6928.137e-3, "eccentricity": 0, "inclination_deg": 0, "raan_deg": 0, "argument_of_perigee_deg": 0, "true_anomaly_deg": 0 } } ] }, "expect_paths": ["$.satellites[0].orbit.semi_major_axis_km"] },
    { "name": "angle in radians instead of degrees out of range", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [ { "id": "a", "orbit": { "semi_major_axis_km": 7000, "eccentricity": 0, "inclination_deg": 0, "raan_deg": 360, "argument_of_perigee_deg": -1, "true_anomaly_deg": 0 } } ] }, "expect_paths": ["$.satellites[0].orbit.raan_deg", "$.satellites[0].orbit.argument_of_perigee_deg"] },
    { "name": "hyperbolic eccentricity", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [ { "id": "a", "orbit": { "semi_major_axis_km": 7000, "eccentricity": 1.2, "inclination_deg": 0, "raan_deg": 0, "argument_of_perigee_deg": 0, "true_anomaly_deg": 0 } } ] }, "expect_paths": ["$.satellites[0].orbit.eccentricity"] },
    { "name": "missing orbit field", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [ { "id": "a", "orbit": { "semi_major_axis_km": 7000, "eccentricity": 0, "inclination_deg": 0, "raan_deg": 0, "argument_of_perigee_deg": 0 } } ] }, "expect_paths": ["$.satellites[0].orbit.true_anomaly_deg"] },
    { "name": "duplicate satellite id", "config": { "schema_version": "1.0.0", "scenario_id": "x", "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [ { "id": "a", "orbit": { "semi_major_axis_km": 7000, "eccentricity": 0, "inclination_deg": 0, "raan_deg": 0, "argument_of_perigee_deg": 0, "true_anomaly_deg": 0 } }, { "id": "a", "orbit": { "semi_major_axis_km": 7100, "eccentricity": 0, "inclination_deg": 0, "raan_deg": 0, "argument_of_perigee_deg": 0, "true_anomaly_deg": 0 } } ] }, "expect_paths": ["$.satellites[1].id"] },
    { "name": "null optional field", "config": { "schema_version": "1.0.0", "scenario_id": "x", "name": null, "seed": 1, "epoch_utc": "2026-10-12T00:00:00Z", "satellites": [] }, "expect_paths": ["$.name"] }
  ]
}
