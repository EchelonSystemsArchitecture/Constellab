{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": ".test-out",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/contract",
    "src/scene/__tests__",
    "src/scenario/__tests__",
    "src/api/__tests__",
    "src/e2e"
  ]
}
